[Unit]
Description=vs-router web API
After=local-fs.target

[Service]
User=vs-router-web
Group=vs-router-web
WorkingDirectory=/var/lib/vs-router
Environment=VS_ROUTER_DATABASE_URL=sqlite:////var/lib/vs-router/vs-router.db
ExecStart=python -m uvicorn vs_router.app:app --uds /run/vs-router/web/web.sock
Restart=on-failure
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vs-router /run/vs-router/web
UMask=0007

[Install]
WantedBy=multi-user.target
