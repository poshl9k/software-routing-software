[Unit]
Description=vs-router restore applied configuration on boot
# Before networkd so .network files land before it starts; nft restores before
# anything external talks to this machine.
Before=systemd-networkd.service caddy.service
DefaultDependencies=no
After=systemd-udev-settle.service nftables.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
# Created by systemd before the sandbox is set up, so the /run path survives a
# reboot; install-time creation alone is lost with /run.
RuntimeDirectory=vs-router-ssh
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 -m vs_router.agent.boot_restore
ExecStartPost=-/usr/bin/python3 /usr/local/libexec/vs-router/reconcile-networkd-boot.py
NoNewPrivileges=yes
ProtectSystem=strict
# No /etc/kea here: it exists only with a DHCP server installed, and a missing
# ReadWritePaths target fails the unit with 226/NAMESPACE. install.sh adds a
# kea.conf drop-in where Kea is present.
ReadWritePaths=/etc/caddy /etc/systemd/system /etc/systemd/network /etc/vs-router /etc/vs-router-ssh /etc/unbound/unbound.conf.d /etc/ppp /run

[Install]
WantedBy=multi-user.target
