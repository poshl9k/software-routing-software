[Unit]
Description=vs-router subscriber portal (UDS)
After=network.target

[Service]
User=vs-router-portal
EnvironmentFile=-/etc/vs-router/secrets.env
Environment=VS_PORTAL_DATABASE_URL=sqlite:////var/lib/vs-router/portal/vs-portal.db
Environment=VS_PORTAL_INTERNAL_SECRET=/etc/vs-router/portal-internal.secret
Environment=VS_PORTAL_STATIC_DIR=/var/lib/vs-router/portal/ui
ExecStart=/usr/bin/python3 -m uvicorn vs_portal.app:app --uds /run/vs-router/portal/portal.sock --proxy-headers --forwarded-allow-ips="*"
UMask=0007
ProtectSystem=strict
ReadWritePaths=/var/lib/vs-router/portal /run/vs-router/portal
Restart=on-failure
ExecStartPost=+/bin/sh -c 'i=0; while [ $i -lt 20 ] && [ ! -S /run/vs-router/portal/portal.sock ]; do sleep 0.5; i=$((i+1)); done; chmod 0660 /run/vs-router/portal/portal.sock && chgrp vs-router-web /run/vs-router/portal/portal.sock'

[Install]
WantedBy=multi-user.target
