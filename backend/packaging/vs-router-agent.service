[Unit]
Description=vs-router configuration agent
After=local-fs.target

[Service]
Type=simple
User=root
Group=vs-router-web
WorkingDirectory=/var/lib/vs-router
Environment=VS_ROUTER_DATABASE_URL=sqlite:////var/lib/vs-router/vs-router.db
ExecStart=/usr/bin/python3 -m vs_router.agent.daemon
Restart=on-failure
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_NETLINK
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/usr /bin
ReadWritePaths=/etc/vs-router /run/vs-router /var/lib/vs-router
UMask=0007

[Install]
WantedBy=multi-user.target
