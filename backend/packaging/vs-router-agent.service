[Unit]
Description=vs-router configuration agent
After=local-fs.target vs-router-bootrestore.service
Requires=vs-router-bootrestore.service

[Service]
Type=simple
User=root
Group=vs-router-web
WorkingDirectory=/var/lib/vs-router
Environment=VS_ROUTER_DATABASE_URL=sqlite:////var/lib/vs-router/vs-router.db
EnvironmentFile=-/etc/vs-router/secrets.env
ExecStart=/usr/bin/python3 -m vs_router.agent.daemon
Restart=on-failure
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_CHOWN
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/usr /bin
ReadWritePaths=/etc/vs-router-ssh /run/vs-router-ssh /var/lib/vs-router-ssh /etc/systemd/network /etc/caddy /etc/systemd/system /etc/vs-router /etc/ppp /run/vs-router /var/lib/vs-router /etc/unbound/unbound.conf.d /etc/kea
UMask=0007

[Install]
WantedBy=multi-user.target
