[Unit]
Description=vs-router local console menu (tty1)
After=vs-router-bootstrap-firstboot.service vs-router-agent.service vs-router-web.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -m vs_router.agent.console_menu
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
