[Unit]
Description=vs-router web TCP bridge (lab/dev only)
# Production access goes over HTTPS through Caddy bridging to the web socket.
# Enable manually for lab access without a reverse proxy:
#   systemctl enable --now vs-router-web-tcp.service
After=vs-router-web.service
Wants=vs-router-web.service

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:8080,fork,reuseaddr UNIX-CONNECT:/run/vs-router/web/web.sock
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/vs-router

[Install]
WantedBy=multi-user.target
