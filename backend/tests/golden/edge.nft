table inet vs_router {
    set a_hosts_4 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 192.168.10.10-192.168.10.20 }
    }
    set a_hosts_6 {
        type ipv6_addr
        flags interval
        auto-merge
        elements = { 2001:db8::/64 }
    }
    set a_clients_4 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 192.168.10.10-192.168.10.20 }
    }
    set a_clients_6 {
        type ipv6_addr
        flags interval
        auto-merge
        elements = { 2001:db8::/64 }
    }
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        iifname != { "eth0", "eth1" } drop
        ct state invalid drop
        ct state established,related accept
        iifname { "eth1" } tcp dport 443 counter accept comment "anti_lockout"
        iifname { "eth1" } meta nfproto ipv4 ip saddr 192.168.10.15 counter drop comment "blocked"
        iifname { "eth1" } meta nfproto ipv4 ip saddr @a_clients_4 meta l4proto tcp tcp dport { 443, 8000-8080 } counter accept comment "web_allow"
        iifname { "eth1" } meta nfproto ipv6 ip6 saddr @a_clients_6 meta l4proto tcp tcp dport { 443, 8000-8080 } counter accept comment "web_allow"
        iifname { "eth1" } meta nfproto ipv4 counter log prefix "vs-router " reject comment "reject_rest"
        iifname { "eth1" } meta nfproto ipv6 counter log prefix "vs-router " reject comment "reject_rest"
    }
    chain forward {
        type filter hook forward priority filter; policy drop;
        iifname != { "eth0", "eth1" } drop
        oifname != { "eth0", "eth1" } drop
        ct state invalid drop
        ct state established,related accept
        iifname "eth0" meta nfproto ipv4 meta l4proto tcp ct status dnat ct original ip daddr 203.0.113.3 ct original proto-dst 443 ip daddr 192.168.10.10 tcp dport 8443 counter accept comment "auto_https"
        iifname { "eth1" } meta nfproto ipv4 ip saddr 192.168.10.15 counter drop comment "blocked"
        iifname { "eth1" } meta nfproto ipv4 ip saddr @a_clients_4 meta l4proto tcp tcp dport { 443, 8000-8080 } counter accept comment "web_allow"
        iifname { "eth1" } meta nfproto ipv6 ip6 saddr @a_clients_6 meta l4proto tcp tcp dport { 443, 8000-8080 } counter accept comment "web_allow"
        iifname { "eth1" } meta nfproto ipv4 counter log prefix "vs-router " reject comment "reject_rest"
        iifname { "eth1" } meta nfproto ipv6 counter log prefix "vs-router " reject comment "reject_rest"
    }
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "eth0" meta nfproto ipv4 ip daddr 203.0.113.3 tcp dport 443 counter dnat ip to 192.168.10.10:8443
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname { "eth0" } meta nfproto ipv4 ip saddr 192.168.10.20 counter return comment "no_nat"
        oifname { "eth0" } meta nfproto ipv4 ip saddr @a_clients_4 counter snat ip to 203.0.113.3 comment "secondary"
        oifname { "eth0" } ip saddr { 192.168.10.0/24 } counter masquerade
    }
}
