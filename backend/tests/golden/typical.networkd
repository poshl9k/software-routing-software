[VLAN]
Id=20
### FILE: 10-vs-router-br0.20.network
[Match]
Name=br0.20

[Network]
DHCP=no
IPv6AcceptRA=no
LinkLocalAddressing=no
Address=192.168.20.1/24
### FILE: 10-vs-router-br0.netdev
[NetDev]
Name=br0
Kind=bridge
### FILE: 10-vs-router-br0.network
[Match]
Name=br0

[Network]
DHCP=no
IPv6AcceptRA=no
LinkLocalAddressing=no
Address=192.168.10.1/24
BindCarrier=eth1 eth2
VLAN=br0.20
### FILE: 10-vs-router-eth0.network
[Match]
Name=eth0

[Network]
DHCP=ipv4
IPv6AcceptRA=no
LinkLocalAddressing=no

[DHCPv4]
UseDNS=no
UseNTP=no
UseHostname=no
UseRoutes=yes
UseGateway=yes
### FILE: 10-vs-router-eth1.network
[Match]
Name=eth1

[Network]
DHCP=no
IPv6AcceptRA=no
LinkLocalAddressing=no
Bridge=br0
### FILE: 10-vs-router-eth2.network
[Match]
Name=eth2

[Network]
DHCP=no
IPv6AcceptRA=no
LinkLocalAddressing=no
Bridge=br0
